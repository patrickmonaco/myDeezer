{
  "name": "myDeezer",
  "short_name": "myDeezer",
  "description": "Vos playlists, coups de cœur et profil Deezer, avec recherche et export.",
  "lang": "fr",
  "start_url": "./#/playlists",
  "scope": "./",
  "display": "standalone",
  "background_color": "#110e18",
  "theme_color": "#13101c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Coups de cœur", "url": "./#/favorites", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mon profil", "url": "./#/profile", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
